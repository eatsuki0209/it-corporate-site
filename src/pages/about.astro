---
import PageLayout from "@/layouts/PageLayout.astro";

const title = "会社概要";
const caption = "About Us";
const description =
  "株式会社プレースホルダーの企業情報を掲載しています。経営コンサルティングとIT技術を融合させ、ビジネスの核心を共に進化させるパートナーを目指します。";
---

<PageLayout title={title} caption={caption} description={description}>
  <table>
    <tbody>
      <tr>
        <th scope="row"><span>会社名</span></th>
        <td>株式会社 プレースホルダー</td>
      </tr>

      <tr>
        <th scope="row"><span>所在地</span></th>
        <td>
          <span>〒100-0001 東京都千代田区〇〇 1-2-3</span>

          <div id="map-container"></div>

          <!-- FIXME: <iframe> があると build が固まる -->
          <!-- <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25924.778293204003!2d139.73577978862596!3d35.68691680240813!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188c0c0b13f54d%3A0xb630953beee48188!2z5p2x5Lqs6YO95Y2D5Luj55Sw5Yy6!5e0!3m2!1sja!2sjp!4v1762922890392!5m2!1sja!2sjp"
            width="400"
            height="300"
            style="border: 0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe> -->
        </td>
      </tr>

      <tr>
        <th scope="row"><span>設立</span></th>
        <td>20XX年X月X日</td>
      </tr>

      <tr>
        <th scope="row"><span>事業内容</span></th>
        <td>
          <ul>
            <li>ITコンサルティング</li>
            <li>システム開発・保守</li>
            <li>ウェブサイト制作</li>
          </ul>
        </td>
      </tr>
    </tbody>
  </table>
</PageLayout>

<style>
  table {
    width: 100%;
    border-spacing: 0;
  }

  tr {
    display: grid;
    gap: 1rem;
    padding: 1.5rem 0;

    &:not(:last-child) {
      border-bottom: 1px solid var(--color-outline-variant);
    }
  }

  th {
    text-align: start;
  }

  iframe {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    margin-top: 1rem;
  }

  ul {
    list-style-position: inside;

    li {
      margin-left: 0.5rem;
    }
  }

  @media screen and (min-width: 48rem) {
    tr {
      grid-template-columns: 200px 1fr;
      gap: 2rem;
      padding: 2rem 0;
    }

    th {
      span {
        display: block;
        position: sticky;
        top: calc(var(--header-height) + 2rem);
      }
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // ブラウザで実行される時だけ iframe を生成する
    const container = document.getElementById("map-container");
    if (container) {
      container.innerHTML = `
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25924.778293204003!2d139.73577978862596!3d35.68691680240813!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60188c0c0b13f54d%3A0xb630953beee48188!2z5p2x5Lqs6YO95Y2D5Luj55Sw5Yy6!5e0!3m2!1sja!2sjp!4v1762922890392!5m2!1sja!2sjp"
          width="400"
          height="300"
          style="border: 0; display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; margin-top: 1rem;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
    `;
    }
  });
</script>
