---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  backLabel: string;
  backHref: string;
}

const { title, description, backLabel, backHref } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="container container--small">
    <div class="content">
      <div class="back-button">
        <Button href={backHref} hasPrev>
          {backLabel}
        </Button>
      </div>

      <article>
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .back-button {
    display: flex;
    justify-content: start;
    padding: 1rem 0 1.5rem;
  }

  article {
    display: grid;
    gap: 1rem;
    padding-bottom: 4rem;

    .header {
      display: grid;
      gap: 1rem;
      padding-bottom: 1rem;
    }

    h1 {
      font-size: var(--heading-m);
      line-height: 1.5;
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .tags {
      list-style-type: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .date {
      flex: 1;
      text-align: end;
    }

    img {
      width: 100%;
      border-radius: var(--radius-medium);
    }

    .description {
      color: var(--color-on-background-variant);
    }

    p {
      line-height: 2;
    }

    h2 {
      padding: 0.5rem;
      border-left: 8px solid var(--color-accent);
      border-bottom: 1px solid var(--color-accent);
      margin-top: 1rem;
      margin-bottom: 0.5rem;
    }
  }
</style>
