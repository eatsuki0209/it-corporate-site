---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title?: string | undefined;
  caption?: string | undefined;
  description?: string | undefined;
}

const { title, caption, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="container">
    <hgroup class="hero">
      <p class="caption"><span>{caption}</span></p>
      <h1 class="title"><span>{title}</span></h1>
    </hgroup>

    <div class="body">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 1rem;
    padding: 4rem 0;
    border-bottom: 1px solid var(--color-outline);
    /* text-align: center; */
  }

  .caption {
    font-size: clamp(1.25rem, 1rem + 1.25vw, 1.75rem);
    font-weight: 500;
    color: var(--color-on-background-variant);
    overflow: hidden;

    span {
      display: block;
      animation: text-show 300ms ease-out;
    }
  }

  .title {
    font-size: clamp(2.5rem, 1.75rem + 3.75vw, 4rem);
    line-height: 1.5;
    overflow: hidden;

    span {
      display: block;
      animation: text-show 300ms ease-out;
    }
  }

  @keyframes text-show {
    from {
      opacity: 0;
      translate: 0 100%;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .body {
    padding: 6rem 0;
  }
</style>
