---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import Tag from "./Tag.astro";

interface Props {
  post: CollectionEntry<"work">;
}

const { post } = Astro.props;
---

<article class="fade-in">
  <a class="link" href={`/works/${post.id}`}></a>

  <div class="image">
    <Image src={post.data.img} alt={post.data.img_alt || ""} />
  </div>

  <div class="text">
    <ul class="tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <Tag tag={tag} href={`/works/tags/${tag}`} />
          </li>
        ))
      }
    </ul>
    <p class="client">{post.data.client}</p>
    <h3 class="title">{post.data.title}</h3>
  </div>
</article>

<style>
  article {
    position: relative;
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    gap: 1rem;
    border-radius: 1rem;

    &::before {
      content: "";
      position: absolute;
      inset: -1rem;
      z-index: -1;
      border-radius: inherit;
      background-color: var(--color-on-background);
      opacity: 0;
      scale: 0.95;
      transition: all 200ms ease-out;
    }

    &:has(.link:hover)::before {
      opacity: 0.12;
      scale: 1;
    }
  }

  .fade-in {
    transition:
      opacity 1s ease-out,
      translate 1s ease-out;
    transition-delay: var(--delay, 0s);

    &:not(.is-visible) {
      opacity: 0;
      translate: 0 3rem;
    }
  }

  .link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }

  .image {
    display: block;
    overflow: hidden;
    border-radius: 0.5rem;

    img {
      width: 100%;
      aspect-ratio: 8 / 5;
      object-fit: cover;
      transition: scale 200ms ease-out;

      article:has(.link:hover) & {
        scale: 1.05;
      }
    }
  }

  .text {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    gap: 0.5rem;
  }

  .client {
    font-size: 0.875rem;
    color: var(--color-on-background-variant);

    &::after {
      content: " 様";
    }
  }

  .title {
    font-weight: 500;
    font-size: 1.25rem;
    line-height: 1.5;

    a {
      text-decoration: none;
      color: inherit;
    }
  }

  .button {
    display: flex;
    justify-content: end;
  }

  .tags {
    list-style-type: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const delayStep = 0.15;
    let lastRowY = -1;
    let rowIndex = 0;

    const fadeInObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target;

            if (!(target instanceof HTMLElement)) {
              return;
            }

            const currentY = target.offsetTop;

            if (lastRowY === -1 || currentY > lastRowY) {
              rowIndex = 0;
              lastRowY = currentY;
            } else {
              rowIndex++;
            }

            const delay = rowIndex * delayStep;

            target.style.setProperty("--delay", `${delay}s`);
            target.classList.add("is-visible");

            // target.animate({
            //   opacity: [0, 1],
            //   translate: ['0 2rem', '0 0'],
            // }, {
            //   duration: 600,
            //   delay: 150 * rowIndex,
            //   fill: 'both',
            // });

            observer.unobserve(target);
          }
        });
      },
      {
        threshold: 0.1,
        // rootMargin: '-30% 0px',
      },
    );

    const fadeInElements = document.querySelectorAll(".fade-in");
    fadeInElements.forEach((fadeInElement) => {
      fadeInObserver.observe(fadeInElement);
    });
  });
</script>
